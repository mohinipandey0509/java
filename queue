class LNode {
    int data;
    LNode next;
    LNode(int data) 
    {
        this.data = data;
        this.next = null;
    }
}
class QueueLinkedList {
    LNode front = null;
    LNode rear = null;
    void enqueue(int value) {
        LNode newNode = new LNode(value);
        if (rear == null) {
            front = rear = newNode;
        } else {
            rear.next = newNode;
            rear = newNode;
        }
        System.out.println(value + " inserted");
    }
    void dequeue() {
        if (front == null) {
            System.out.println("Queue Underflow");
            return;
        }
        System.out.println(front.data + " removed");
        front = front.next;
        if (front == null) {
            rear = null;
        }
    }
    void peek() {
        if (front == null) {
            System.out.println("Queue is empty");
        } else {
            System.out.println("Front element: " + front.data);
        }
    }
    void display() {
        if (front == null) {
            System.out.println("Queue is empty");
            return;
        }
        LNode temp = front;
        System.out.print("Queue: ");
        while (temp != null) {
            System.out.print(temp.data + " ");
            temp = temp.next;
        }
        System.out.println();
    }
}
class Main {
    public static void main(String[] args) {
        System.out.println("Queue using Linked list");
		QueueLinkedList q = new QueueLinkedList();
		q.enqueue(100);
        q.enqueue(200);
        q.enqueue(300);
        q.display();
        q.dequeue();
        q.display();
        q.enqueue(400);
        q.enqueue(500);
        q.display();
        q.peek();
        q.dequeue();
        q.dequeue();
        q.dequeue();
        q.dequeue(); 
        q.display();
        
    }
}
