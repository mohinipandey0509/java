class NodeM{
    int data;
    NodeM next;
    NodeM(int data){
        this.data = data;
        this.next = null;
    }
    
}
class LinkedListM {
    NodeM head = null;
    void insert(int value){
        NodeM newNode = new NodeM(value);
        if(head == null){
            head = newNode;
        }
        else{
            NodeM temp = head;
            while(temp.next !=null){
                temp = temp.next;
            }
            temp.next = newNode;
        }
    }
    void findMiddle(){
        NodeM temp = head;
        int count = 0;
        while(temp !=null){
            count++;
            temp=temp.next;
        }
        int mid = count/2;
        temp=head;
        for(int i=0;i<mid;i++){
            temp=temp.next;
        }
        System.out.println("Middle element="+temp.data);
    }
}

class Main {
    public static void main(String[] args) {
        System.out.println("find the Middle node");
        LinkedListM list=new LinkedListM();
        list.insert(1);
         list.insert(2);
         list.insert(3); 
         list.insert(4);
         list.insert(5);
         list.insert(6);
         list.findMiddle();
    }
}
